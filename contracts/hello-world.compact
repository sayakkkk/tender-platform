pragma language_version >= 0.23;

import CompactStandardLibrary;

export enum TenderStatus { Open, Closed, Awarded }

export ledger tenderId: Uint<64>;
export ledger authority: Bytes<32>;
export ledger title: Opaque<"string">;
export ledger deadline: Uint<64>;
export ledger status: TenderStatus;
export ledger winningVendor: Bytes<32>;
export ledger winningBidAmount: Uint<64>;
export ledger registeredVendorsCount: Uint<64>;
export ledger totalBidsCount: Uint<64>;

witness secretBidAmount(): Uint<64>;
witness secretProposalHash(): Bytes<32>;
witness vendorEligibilitySecret(): Bytes<32>;

export circuit createTender(
    id: Uint<64>,
    auth: Bytes<32>,
    tTitle: Opaque<"string">,
    subDeadline: Uint<64>
): [] {
    tenderId = disclose(id);
    authority = disclose(auth);
    title = disclose(tTitle);
    deadline = disclose(subDeadline);
    status = disclose(TenderStatus.Open);
    registeredVendorsCount = disclose(0);
    totalBidsCount = disclose(0);
    winningBidAmount = disclose(0);
}

export circuit registerVendor(vendorId: Bytes<32>): [] {
    const el = vendorEligibilitySecret();
    registeredVendorsCount = disclose((registeredVendorsCount + 1) as Uint<64>);
}

export circuit submitSealedBid(vendorId: Bytes<32>, currentTimestamp: Uint<64>): [] {
    assert(status == TenderStatus.Open, "Tender is not open");
    assert(currentTimestamp <= deadline, "Tender submission deadline has passed");
    
    const amt = secretBidAmount();
    const hash = secretProposalHash();
    assert(amt > 0, "Bid amount must be positive");

    totalBidsCount = disclose((totalBidsCount + 1) as Uint<64>);
}

export circuit closeTender(currentTimestamp: Uint<64>): [] {
    assert(currentTimestamp >= deadline, "Tender deadline has not passed yet");
    assert(status == TenderStatus.Open, "Tender is not open");
    status = disclose(TenderStatus.Closed);
}

export circuit revealWinner(winner: Bytes<32>, bidAmt: Uint<64>): [] {
    assert(status == TenderStatus.Closed, "Tender must be closed before revealing winner");
    winningVendor = disclose(winner);
    winningBidAmount = disclose(bidAmt);
    status = disclose(TenderStatus.Awarded);
}